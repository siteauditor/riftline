# Riot API key. Development keys expire every 24 hours -- regenerate at
# https://developer.riotgames.com and paste the new one here.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Shard used when the UI does not specify one.
DEFAULT_PLATFORM=euw1

# Application rate limits, in Riot's own syntax. A development key is 20:1,100:120.
# Raise this only when you actually hold a personal or production key.
APP_RATE_LIMITS=20:1,100:120

# sqlite by default; swap for postgresql+asyncpg://... to scale out.
DATABASE_URL=sqlite+aiosqlite:///data/lol.db

# Riot announced Spectator-V5's deactivation (Oct 2025). Set false to hide
# live-game features pre-emptively.
ENABLE_SPECTATOR=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How long one web request may wait for a rate-limit slot before answering 429
# with Retry-After. Cloudflare abandons an origin at 100 seconds. The ingest
# CLI ignores this and waits for the key.
RIOT_WAIT_BUDGET_SECONDS=40

# The absolute origin the sitemap and canonical links are written with.
# SITE_ORIGIN=https://www.rhasta.space

# Groups (/groups). How far back a group reads each player: their newest N
# games in every queue, when they are added. Each is one Riot call the first
# time and about 85 KB of database, 160 KB with a timeline.
# GROUP_HISTORY_CAP=300
# Riot calls the nightly `groups` stage may spend, most recently viewed first.
# GROUP_NIGHTLY_CALLS=2000
# Per visitor address, per hour: there is no login, so these stop one script
# filling the database with groups or the key with lookups.
# GROUP_CREATES_PER_HOUR=10
# GROUP_ADDS_PER_HOUR=60

# Players the nightly `names` stage confirms with Riot: those with enough scored
# games for a profile page whose Riot ID no lookup has confirmed yet, newest
# game first. Two Riot calls each, and never the calls kept for searches.
# NAME_CHECKS_NIGHTLY=300
