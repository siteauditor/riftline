# Riftline configuration. Copy to .env and fill in.
#
# `.env` is gitignored and must stay that way: the Riot key is a credential.
# On the server this file lives beside docker-compose.yml and is read by the api
# container at start. Changing it needs a container restart, not a rebuild:
#
#     docker compose up -d --force-recreate api
#
# Rotating the key is one command; see docs/deploy.md.

# Riot API key. A development key from developer.riotgames.com expires 24 hours
# after it is issued. While it is expired, everything that needs a live Riot
# call (profile search, match history, mastery, live game) reports that the key
# needs renewing, and everything served from the stored corpus (tier list,
# champion pages, leaderboards, the Riftline scores) carries on working.
RIOT_API_KEY=RGAPI-your-key-here

# Where the corpus lives. The compose file sets this explicitly for the
# container; this default is for running the backend directly on a workstation.
# DATABASE_URL=sqlite+aiosqlite:///data/lol.db

# Browser origins allowed to call the API cross-origin. The site itself does not
# need this: it reaches /api on its own origin through the web container.
# CORS_ORIGINS=https://riftline.rhasta.space

# Rate limits the client obeys, as "requests:seconds" pairs. The defaults match
# a development key (20 per second, 100 per two minutes); a production key is
# far higher and this is where you would say so.
# APP_RATE_LIMITS=20:1,100:120

# Spectator (live game) lookups. Riot announced the deactivation of
# spectator-v5, so this flag exists to turn the tab off without a deploy.
# ENABLE_SPECTATOR=true
